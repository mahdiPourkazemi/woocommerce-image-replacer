# Copy this file to ".env" (beside the program) and fill in your own values.
# این فایل را با نام ".env" کنار برنامه کپی کنید و مقادیر خودتان را بنویسید.
# Never commit the real .env file. / فایل .env واقعی را هرگز منتشر نکنید.

# Store address: HTTPS only, without /wp-json
WC_BASE_URL=https://example.com

# WooCommerce REST API key with Read/Write permission
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Optional: only needed to upload a NEW image from inside the app.
# WordPress user + Application Password (not the WooCommerce key).
WP_USERNAME=
WP_APPLICATION_PASSWORD=
